{
  "expo": {
    "name": "MVP - Whisp",
    "slug": "mvpWhisp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mvpwhisp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mvpwhisp.app",
      "appleTeamId": "L374XCGF32",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Whisp usa el micrófono durante llamadas (CallKit / POC).",
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true,
        "com.apple.developer.family-controls": true,
        "com.apple.security.application-groups": [
          "group.com.mvpwhisp.blocker"
        ]
      }
    },
    "android": {
      "package": "com.mvpwhisp.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true
          }
        }
      ],
      [
        "expo-app-blocker",
        {
          "ios": {
            "appGroup": "group.com.mvpwhisp.blocker",
            "shield": {
              "title": "Whisp",
              "subtitle": "{appName} está bloqueada.",
              "primaryButtonLabel": "Volver a Whisp",
              "secondaryButtonLabel": null,
              "primaryButtonColor": "#2563eb",
              "backgroundColor": "#0c0c0f",
              "titleColor": "#fafafa",
              "subtitleColor": "#a1a1aa"
            }
          },
          "android": {
            "notificationTitle": "Whisp — app bloqueada",
            "notificationText": "{appName} está bloqueada."
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a697cd4b-0450-46a9-bacf-49f4365fa171",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "DeviceActivityMonitor",
                  "bundleIdentifier": "com.mvpwhisp.app.DeviceActivityMonitor",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.mvpwhisp.blocker"
                    ]
                  }
                },
                {
                  "targetName": "ShieldAction",
                  "bundleIdentifier": "com.mvpwhisp.app.ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.mvpwhisp.blocker"
                    ]
                  }
                },
                {
                  "targetName": "ShieldConfiguration",
                  "bundleIdentifier": "com.mvpwhisp.app.ShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.mvpwhisp.blocker"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "hdirtvep"
  }
}
